          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.symbol AS \"Symbol\", p.name AS \"Name\", p.account_name AS \"Account\",\n       p.asset_class AS \"Asset class\", p.price_currency AS \"Currency\",\n       p.quantity_open AS \"Quantity\",\n       p.cost_basis_usd / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS \"Cost basis\",\n       p.market_value_usd / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS \"Market value\",\n       p.unrealized_pl_usd / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS \"Unrealized P/L\",\n       p.unrealized_pl_pct AS \"Unrealized P/L %\",\n       p.weight_pct AS \"Weight %\"\nFROM portfolio_positions p\nORDER BY p.market_value_usd DESC NULLS LAST"
        }
      ]
