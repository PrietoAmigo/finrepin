          "rawQuery": true,
          "rawSql": "WITH fx AS (SELECT COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date <= CURRENT_DATE ORDER BY date DESC LIMIT 1), 1) AS rate), held AS ( SELECT * FROM portfolio_positions WHERE account = ANY(string_to_array('${account:csv}', ',')) ), total AS (SELECT sum(market_value) AS value FROM held WHERE quantity > 0) SELECT p.symbol AS \"Symbol\", p.instrument AS \"Name\", p.account AS \"Account\", p.asset_class AS \"Asset class\", p.sector AS \"Sector\", p.region AS \"Region\", p.quantity AS \"Quantity\", p.avg_cost / fx.rate AS \"Avg cost\", p.price_usd / fx.rate AS \"Last price\", p.cost_basis / fx.rate AS \"Cost basis\", p.market_value / fx.rate AS \"Market value\", p.unrealized / fx.rate AS \"Unrealized\", p.unrealized_pct AS \"Unrealized %\", p.realized / fx.rate AS \"Realized\", 100.0 * p.market_value / NULLIF(total.value, 0) AS \"Weight %\" FROM held p, fx, total WHERE p.quantity <> 0 OR p.realized <> 0 ORDER BY p.market_value DESC NULLS LAST"
