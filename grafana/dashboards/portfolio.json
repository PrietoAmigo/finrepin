      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH fx AS (SELECT COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date <= CURRENT_DATE ORDER BY date DESC LIMIT 1), 1) AS rate), window_days AS ( SELECT d.account_id, d.instrument_id, min(d.date) AS first_day, max(d.date) AS last_day FROM portfolio_position_daily d JOIN accounts a ON a.id = d.account_id WHERE a.name = ANY(string_to_array('${account:csv}', ',')) AND $__timeFilter(d.date) GROUP BY 1, 2 ), edges AS ( SELECT w.instrument_id, o.price_usd AS open_price, c.price_usd AS close_price, c.quantity, o.unrealized + o.realized AS open_pl, c.unrealized + c.realized AS close_pl FROM window_days w JOIN portfolio_position_daily o ON o.account_id = w.account_id AND o.instrument_id = w.instrument_id AND o.date = w.first_day JOIN portfolio_position_daily c ON c.account_id = w.account_id AND c.instrument_id = w.instrument_id AND c.date = w.last_day ) SELECT i.symbol AS \"Symbol\", sum(e.close_pl - e.open_pl) / max(fx.rate) AS value FROM edges e JOIN instruments i ON i.id = e.instrument_id, fx GROUP BY i.symbol HAVING sum(e.close_pl - e.open_pl) <> 0 ORDER BY 2 DESC"
        }
      ]
