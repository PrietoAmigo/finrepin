    {
      "id": 7,
      "type": "timeseries",
      "title": "Portfolio value over time ($display_currency)",
      "description": "Daily total market value of open positions, replaying each lot from its acquisition date (and, once fully sold, dropping it out) against forward-filled daily closes. A partial sale is not date-stamped per lot, so it is not reflected here until the lot is fully closed \u2014 see migration 0023.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT v.date::timestamptz AS \"time\", v.value_usd / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS value\nFROM portfolio_value_daily v\nWHERE $__timeFilter(v.date)\nORDER BY 1"
        }
      ]
    },
