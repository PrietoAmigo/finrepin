    {
      "id": 7,
      "type": "timeseries",
      "title": "Portfolio value vs cost basis — $display_currency",
      "description": "Daily mark-to-market of every position held that day against what it cost. Both lines carry across weekends and holidays (the last close and the last ledger state are held forward), so the series has one point per calendar day.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost basis"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH totals AS ( SELECT d.date, sum(d.market_value) AS market_value, sum(d.cost_basis) AS cost_basis FROM portfolio_position_daily d JOIN accounts a ON a.id = d.account_id WHERE a.name = ANY(string_to_array('${account:csv}', ',')) GROUP BY d.date ) SELECT t.date::timestamptz AS \"time\", m.metric, (CASE WHEN m.metric = 'Market value' THEN t.market_value ELSE t.cost_basis END) / COALESCE(NULLIF(fx.usd_rate, 0), 1) AS value FROM totals t CROSS JOIN (VALUES ('Market value'), ('Cost basis')) AS m(metric) LEFT JOIN fx_usd_daily fx ON fx.currency = '$display_currency' AND fx.date = t.date WHERE $__timeFilter(t.date) ORDER BY 1, 2"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Drawdown from all-time high",
      "description": "How far the portfolio sits below its highest value ever reached (0% = at a new high). The peak is taken over the whole history, not just the visible range, so zooming in never invents a new high.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "spanNulls": true,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "unit": "percent",
          "decimals": 2,
          "max": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH totals AS ( SELECT d.date, sum(d.market_value) AS market_value FROM portfolio_position_daily d JOIN accounts a ON a.id = d.account_id WHERE a.name = ANY(string_to_array('${account:csv}', ',')) GROUP BY d.date ), peaks AS ( SELECT date, market_value, max(market_value) OVER (ORDER BY date) AS ath FROM totals ) SELECT date::timestamptz AS \"time\", 'Drawdown' AS metric, CASE WHEN ath > 0 THEN 100.0 * (market_value / ath - 1) END AS value FROM peaks WHERE $__timeFilter(date) ORDER BY 1"
        }
      ]
    },
