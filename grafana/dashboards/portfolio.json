    {
      "id": 1,
      "type": "stat",
      "title": "Market value — $display_currency",
      "description": "Every open position marked at its latest close, converted into the selected display currency.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH fx AS (SELECT COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date <= CURRENT_DATE ORDER BY date DESC LIMIT 1), 1) AS rate) SELECT sum(p.market_value) / fx.rate AS value FROM portfolio_positions p, fx WHERE p.account = ANY(string_to_array('${account:csv}', ',')) GROUP BY fx.rate"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "ROIC",
      "description": "Unrealized P/L as a percentage of the cost basis of the open positions. Currency-independent, so the display currency doesn't move it.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH fx AS (SELECT COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date <= CURRENT_DATE ORDER BY date DESC LIMIT 1), 1) AS rate) SELECT 100.0 * sum(p.unrealized) / NULLIF(sum(p.cost_basis), 0) AS value FROM portfolio_positions p, fx WHERE p.account = ANY(string_to_array('${account:csv}', ',')) GROUP BY fx.rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Portfolio value vs cost basis — $display_currency",
      "description": "Daily mark-to-market of every position held that day against what it cost. Both lines carry across weekends and holidays (the last close and the last ledger state are held forward), so the series has one point per calendar day.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost basis"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH totals AS ( SELECT d.date, sum(d.market_value) AS market_value, sum(d.cost_basis) AS cost_basis FROM portfolio_position_daily d JOIN accounts a ON a.id = d.account_id WHERE a.name = ANY(string_to_array('${account:csv}', ',')) GROUP BY d.date ) SELECT t.date::timestamptz AS \"time\", m.metric, (CASE WHEN m.metric = 'Market value' THEN t.market_value ELSE t.cost_basis END) / COALESCE(NULLIF(fx.usd_rate, 0), 1) AS value FROM totals t CROSS JOIN (VALUES ('Market value'), ('Cost basis')) AS m(metric) LEFT JOIN fx_usd_daily fx ON fx.currency = '$display_currency' AND fx.date = t.date WHERE $__timeFilter(t.date) ORDER BY 1, 2"
        }
      ]
    },
