{
  "uid": "fintracker-portfolio",
  "title": "Portfolio",
  "description": "Holdings-based personal-finance surface: portfolio value over time, allocation by asset class/sector/currency/region, unrealized & realized P/L, cost basis vs. market, best/worst movers, and drawdown from ATH. Backed by the holdings/accounts tables and the portfolio_* SQL views (migrations 0022-0023). Add holdings from the Manage dashboard or `python -m fintracker.manage holding add`.",
  "tags": [
    "fintracker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-2y",
    "to": "now"
  },
  "timepicker": {
    "quick_ranges": [
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      },
      {
        "display": "Last 90 days",
        "from": "now-90d",
        "to": "now"
      },
      {
        "display": "Last 6 months",
        "from": "now-6M",
        "to": "now"
      },
      {
        "display": "Last 1 year",
        "from": "now-1y",
        "to": "now"
      },
      {
        "display": "Last 2 years",
        "from": "now-2y",
        "to": "now"
      },
      {
        "display": "Last 5 years",
        "from": "now-5y",
        "to": "now"
      },
      {
        "display": "Last 15 years",
        "from": "now-15y",
        "to": "now"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "display_currency",
        "label": "Currency",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "fintracker-pg"
        },
        "query": "SELECT DISTINCT split_part(unit, '/', 1) AS currency FROM fundamentals WHERE unit ~ '^[A-Z]{3}(/shares)?$' UNION SELECT currency FROM instruments UNION SELECT currency FROM holdings ORDER BY 1",
        "definition": "SELECT DISTINCT split_part(unit, '/', 1) AS currency FROM fundamentals WHERE unit ~ '^[A-Z]{3}(/shares)?$' UNION SELECT currency FROM instruments UNION SELECT currency FROM holdings ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "USD",
          "value": "USD"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Portfolio value ($display_currency)",
      "description": "Latest total market value of every open position, converted to the selected display currency via fx_usd_daily.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.value_usd / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS value\nFROM portfolio_value_daily v\nORDER BY v.date DESC\nLIMIT 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unrealized P/L ($display_currency)",
      "description": "Sum of market value minus cost basis across every currently open position.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(p.unrealized_pl_usd) / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS value\nFROM portfolio_positions p"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Realized P/L ($display_currency)",
      "description": "Sum of proceeds minus the matching cost-basis slice across every sale (partial or full) ever recorded.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(r.realized_pl_usd), 0) / COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date = CURRENT_DATE), 1) AS value\nFROM portfolio_realized_pl r"
        }
      ]
    },
