      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH fx AS (SELECT COALESCE((SELECT usd_rate FROM fx_usd_daily WHERE currency = '$display_currency' AND date <= CURRENT_DATE ORDER BY date DESC LIMIT 1), 1) AS rate), held AS ( SELECT * FROM portfolio_positions WHERE account = ANY(string_to_array('${account:csv}', ',')) ), total AS (SELECT sum(market_value) AS value FROM held WHERE quantity > 0), day_chg AS ( SELECT instrument_id, 100.0 * (close_now / NULLIF(close_prev, 0) - 1) AS change_pct FROM ( SELECT p.instrument_id, p.close::float8 AS close_now, lag(p.close::float8) OVER (PARTITION BY p.instrument_id ORDER BY p.date) AS close_prev, row_number() OVER (PARTITION BY p.instrument_id ORDER BY p.date DESC) AS rn FROM prices p ) s WHERE s.rn = 1 ) SELECT p.symbol AS \"Symbol\", 100.0 * p.market_value / NULLIF(total.value, 0) AS \"Weight %\", dc.change_pct AS \"Daily change %\", p.unrealized_pct AS \"Unrealized %\", p.price_usd / fx.rate AS \"Last price\", p.avg_cost / fx.rate AS \"Avg cost\", p.quantity AS \"Quantity\", p.market_value / fx.rate AS \"Market value\", p.asset_class AS \"Asset class\", p.sector AS \"Sector\", p.region AS \"Region\" FROM held p LEFT JOIN day_chg dc ON dc.instrument_id = p.instrument_id, fx, total WHERE p.quantity <> 0 OR p.realized <> 0 ORDER BY p.market_value DESC NULLS LAST"
        }
      ]
