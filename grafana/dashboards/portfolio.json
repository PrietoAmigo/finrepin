          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.trade_date AS \"Date\", a.name AS \"Account\", i.symbol AS \"Symbol\", t.side AS \"Side\", t.quantity AS \"Quantity\", t.price AS \"Price\", t.fees AS \"Fees\", t.currency AS \"Currency\", (CASE WHEN t.side = 'buy' THEN -1 ELSE 1 END) * (t.quantity * t.price) - t.fees AS \"Cash flow\", COALESCE(t.note, '') AS \"Note\" FROM portfolio_transactions t JOIN accounts a ON a.id = t.account_id JOIN instruments i ON i.id = t.instrument_id WHERE a.name = ANY(string_to_array('${account:csv}', ',')) ORDER BY t.trade_date DESC, t.id DESC LIMIT 100"
