      },
      {
        "name": "detail_span",
        "label": "Detail history",
        "description": "How far back the Detail instrument's closes go, as a relative time such as 9000d. The Detail chart uses it as its time range so it always shows the whole history.",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "fintracker-pg"
        },
        "query": "SELECT (GREATEST(CURRENT_DATE - min(p.date), 0) + 1)::text || 'd' FROM prices p JOIN instruments i ON i.id = p.instrument_id WHERE i.symbol = '$symbol' AND p.close > 0",
