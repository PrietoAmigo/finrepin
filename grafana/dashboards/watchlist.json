          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS ( SELECT i.id, i.symbol, i.name, i.kind, i.currency FROM instruments i WHERE i.in_watchlist ), px AS ( SELECT p.instrument_id, p.date, p.close::float8 AS close FROM prices p JOIN w ON w.id = p.instrument_id WHERE p.close > 0 AND p.date > CURRENT_DATE - 800 ), last AS ( SELECT DISTINCT ON (instrument_id) instrument_id, date, close FROM px ORDER BY instrument_id, date DESC )  SELECT w.symbol AS \"Symbol\", 100.0 * (1 - l.close / max(x.close)) AS \"Below 52-week high\" FROM last l JOIN w ON w.id = l.instrument_id JOIN px x ON x.instrument_id = l.instrument_id AND x.date > l.date - 365 GROUP BY w.symbol, l.close ORDER BY 2 DESC"
