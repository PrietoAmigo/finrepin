          "rawSql": "WITH w AS ( SELECT i.id, i.symbol, i.name, i.kind, i.currency FROM instruments i WHERE i.in_watchlist ), px AS ( SELECT p.instrument_id, p.date, p.close::float8 AS close FROM prices p JOIN w ON w.id = p.instrument_id WHERE p.close > 0 AND p.date > CURRENT_DATE - 800 ), last AS ( SELECT DISTINCT ON (instrument_id) instrument_id, date, close FROM px ORDER BY instrument_id, date DESC )  , stats AS ( SELECT l.instrument_id, l.date, l.close, (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date < l.date ORDER BY x.date DESC LIMIT 1) AS d1, (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date <= l.date - 7 ORDER BY x.date DESC LIMIT 1) AS w1, (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date <= l.date - 30 ORDER BY x.date DESC LIMIT 1) AS m1, (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date < date_trunc('year', l.date)::date ORDER BY x.date DESC LIMIT 1) AS ytd, (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date <= l.date - 365 ORDER BY x.date DESC LIMIT 1) AS y1, (SELECT max(x.close::float8) FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date > l.date - 365) AS hi52, (SELECT min(x.close::float8) FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 AND x.date > l.date - 365) AS lo52, (SELECT CASE WHEN count(*) = 200 THEN avg(s.close) END FROM (SELECT x.close::float8 FROM prices x WHERE x.instrument_id = l.instrument_id AND x.close::float8 > 0 AND x.date > CURRENT_DATE - 800 ORDER BY x.date DESC LIMIT 200) s) AS ma200 FROM last l ), eps AS ( SELECT DISTINCT ON (t.instrument_id) t.instrument_id, t.period_end, t.value FROM equity_flows_ttm t WHERE t.grp = 'eps' AND t.instrument_id = ANY(ARRAY(SELECT id FROM w WHERE kind = 'equity')) ORDER BY t.instrument_id, t.period_end DESC ), shares AS ( SELECT DISTINCT ON (g.instrument_id) g.instrument_id, g.period_end, g.value FROM fundamentals_grouped g WHERE g.grp = 'shares_diluted' AND g.instrument_id = ANY(ARRAY(SELECT id FROM w WHERE kind = 'equity')) ORDER BY g.instrument_id, g.period_end DESC, g.period_days ), rep AS ( SELECT w.id AS instrument_id, (SELECT split_part(f.unit, '/', 1) FROM fundamentals f WHERE f.instrument_id = w.id AND f.unit ~ '^[A-Z]{3}(/shares)?$' GROUP BY 1 ORDER BY count(*) DESC LIMIT 1) AS currency FROM w WHERE w.kind = 'equity' ), fx AS ( SELECT split_part(f.symbol, '/', 1) AS currency, (SELECT r.close::float8 FROM prices r WHERE r.instrument_id = f.id ORDER BY r.date DESC LIMIT 1) AS usd_rate FROM instruments f WHERE f.kind = 'forex' AND f.symbol LIKE '%/USD' UNION ALL SELECT 'USD', 1.0 ) SELECT w.symbol AS \"Symbol\", w.name AS \"Name\", CASE w.kind WHEN 'equity' THEN 'Stock' WHEN 'crypto' THEN 'Crypto' WHEN 'metal' THEN 'Metal' WHEN 'index' THEN 'Index / fund' WHEN 'forex' THEN 'FX' ELSE initcap(w.kind) END AS \"Type\", s.close AS \"Last price\", w.currency AS \"Ccy\", 100.0 * (s.close / NULLIF(s.d1, 0) - 1) AS \"1D\", 100.0 * (s.close / NULLIF(s.w1, 0) - 1) AS \"1W\", 100.0 * (s.close / NULLIF(s.m1, 0) - 1) AS \"1M\", 100.0 * (s.close / NULLIF(s.ytd, 0) - 1) AS \"YTD\", 100.0 * (s.close / NULLIF(s.y1, 0) - 1) AS \"1Y\", 100.0 * (s.close / NULLIF(s.ma200, 0) - 1) AS \"vs 200-day avg\", 100.0 * (1 - s.close / NULLIF(s.hi52, 0)) AS \"Below 52w high\", 100.0 * (s.close - s.lo52) / NULLIF(s.hi52 - s.lo52, 0) AS \"52w range\", CASE WHEN e.value > 0 AND e.period_end <= s.date AND s.date < e.period_end + 450 THEN s.close * CASE WHEN r.currency IS NULL OR r.currency = w.currency THEN 1 ELSE COALESCE(fxl.usd_rate / NULLIF(fxr.usd_rate, 0), 1) END / e.value END AS \"P/E\", CASE WHEN sh.period_end <= s.date AND s.date < sh.period_end + 450 THEN s.close * sh.value * fxl.usd_rate END AS \"Mkt cap (USD)\", to_char(ed.earnings_date, 'YYYY-MM-DD') || CASE WHEN ed.is_estimated THEN ' (est.)' ELSE '' END AS \"Next earnings\" FROM w LEFT JOIN stats s ON s.instrument_id = w.id LEFT JOIN eps e ON e.instrument_id = w.id LEFT JOIN shares sh ON sh.instrument_id = w.id LEFT JOIN rep r ON r.instrument_id = w.id LEFT JOIN fx fxl ON fxl.currency = w.currency LEFT JOIN fx fxr ON fxr.currency = r.currency LEFT JOIN earnings_dates ed ON ed.instrument_id = w.id AND ed.earnings_date >= CURRENT_DATE ORDER BY 8 DESC NULLS LAST, w.symbol"
        }
      ]
    },
    {
      "id": 102,
