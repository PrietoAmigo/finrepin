          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT s.time, s.\"Close\", s.\"50-day avg\", s.\"200-day avg\" FROM ( SELECT p.date, p.date::timestamptz AS \"time\", p.close::float8 AS \"Close\", CASE WHEN row_number() OVER w >= 50 THEN avg(p.close::float8) OVER (w ROWS BETWEEN 49 PRECEDING AND CURRENT ROW) END AS \"50-day avg\", CASE WHEN row_number() OVER w >= 200 THEN avg(p.close::float8) OVER (w ROWS BETWEEN 199 PRECEDING AND CURRENT ROW) END AS \"200-day avg\" FROM prices p JOIN instruments i ON i.id = p.instrument_id WHERE i.symbol = '$symbol' AND p.close > 0 WINDOW w AS (ORDER BY p.date) ) s WHERE $__timeFilter(s.date) ORDER BY 1"
        }
