    {
      "id": 2,
      "type": "stat",
      "title": "Best month",
      "description": "The watched name that rose most over the last 30 days.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS ( SELECT i.id, i.symbol, i.name, i.kind, i.currency FROM instruments i WHERE i.in_watchlist ), px AS ( SELECT p.instrument_id, p.date, p.close::float8 AS close FROM prices p JOIN w ON w.id = p.instrument_id WHERE p.close > 0 AND p.date > CURRENT_DATE - 800 ), last AS ( SELECT DISTINCT ON (instrument_id) instrument_id, date, close FROM px ORDER BY instrument_id, date DESC )  SELECT w.symbol AS \"Symbol\", 100.0 * (l.close / NULLIF((SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date <= l.date - 30 ORDER BY x.date DESC LIMIT 1), 0) - 1) AS \"1M\" FROM last l JOIN w ON w.id = l.instrument_id"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "1M",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 1
          }
        }
      ]
    },
