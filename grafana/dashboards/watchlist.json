    {
      "id": 9,
      "type": "timeseries",
      "title": "$symbol — drawdown from all-time high, full history",
      "description": "How far each close is below the highest close up to that day: 0% means at a new high, -30% means 30% below the peak. Always covers every stored close, whatever the time picker says (zooming in on the chart still works). The legend shows the drawdown at the latest close (Last) and the deepest one ever (Min, the maximum drawdown). Pick the instrument with the Detail selector at the top, or click a symbol in the Watchlist table.",
      "datasource": {
        "type": "postgres",
        "uid": "fintracker-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "timeFrom": "$detail_span",
      "hideTimeOverride": true,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "percent",
          "decimals": 1,
          "max": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "fintracker-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.date::timestamptz AS \"time\", 100.0 * (p.close::float8 / max(p.close::float8) OVER (ORDER BY p.date ROWS UNBOUNDED PRECEDING) - 1) AS \"Drawdown\" FROM prices p JOIN instruments i ON i.id = p.instrument_id WHERE i.symbol = '$symbol' AND p.close > 0 ORDER BY 1"
        }
      ]
    },
