          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS ( SELECT i.id, i.symbol, i.name, i.kind, i.currency FROM instruments i WHERE i.in_watchlist ), px AS ( SELECT p.instrument_id, p.date, p.close::float8 AS close FROM prices p JOIN w ON w.id = p.instrument_id WHERE p.close > 0 AND p.date > CURRENT_DATE - 800 ), last AS ( SELECT DISTINCT ON (instrument_id) instrument_id, date, close FROM px ORDER BY instrument_id, date DESC )  , stats AS ( SELECT l.instrument_id, l.close, (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date < l.date ORDER BY x.date DESC LIMIT 1) AS d1, (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date <= l.date - 7 ORDER BY x.date DESC LIMIT 1) AS w1, (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date <= l.date - 30 ORDER BY x.date DESC LIMIT 1) AS m1, (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date < date_trunc('year', l.date)::date ORDER BY x.date DESC LIMIT 1) AS ytd, (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id AND x.date <= l.date - 365 ORDER BY x.date DESC LIMIT 1) AS y1, (SELECT max(x.close) FROM px x WHERE x.instrument_id = l.instrument_id AND x.date > l.date - 365) AS hi52, (SELECT min(x.close) FROM px x WHERE x.instrument_id = l.instrument_id AND x.date > l.date - 365) AS lo52, (SELECT CASE WHEN count(*) = 200 THEN avg(s.close) END FROM (SELECT x.close FROM px x WHERE x.instrument_id = l.instrument_id ORDER BY x.date DESC LIMIT 200) s) AS ma200 FROM last l ), val AS ( SELECT DISTINCT ON (m.instrument_id, m.metric) m.instrument_id, m.metric, m.value, m.currency FROM equity_metric_series m WHERE m.metric IN ('pe', 'mcap') AND m.instrument_id IN (SELECT i.id FROM instruments i WHERE i.in_watchlist AND i.kind = 'equity') ORDER BY m.instrument_id, m.metric, m.time DESC ), fx AS ( SELECT DISTINCT ON (currency) currency, usd_rate FROM fx_usd_daily ORDER BY currency, date DESC ) SELECT w.symbol AS \"Symbol\", w.name AS \"Name\", CASE w.kind WHEN 'equity' THEN 'Stock' WHEN 'crypto' THEN 'Crypto' WHEN 'metal' THEN 'Metal' WHEN 'index' THEN 'Index / fund' WHEN 'forex' THEN 'FX' ELSE initcap(w.kind) END AS \"Type\", s.close AS \"Last price\", w.currency AS \"Ccy\", 100.0 * (s.close / NULLIF(s.d1, 0) - 1) AS \"1D\", 100.0 * (s.close / NULLIF(s.w1, 0) - 1) AS \"1W\", 100.0 * (s.close / NULLIF(s.m1, 0) - 1) AS \"1M\", 100.0 * (s.close / NULLIF(s.ytd, 0) - 1) AS \"YTD\", 100.0 * (s.close / NULLIF(s.y1, 0) - 1) AS \"1Y\", 100.0 * (s.close / NULLIF(s.ma200, 0) - 1) AS \"vs 200-day avg\", 100.0 * (1 - s.close / NULLIF(s.hi52, 0)) AS \"Below 52w high\", 100.0 * (s.close - s.lo52) / NULLIF(s.hi52 - s.lo52, 0) AS \"52w range\", pe.value AS \"P/E\", mc.value * fx.usd_rate AS \"Mkt cap (USD)\", to_char(ed.earnings_date, 'YYYY-MM-DD') || CASE WHEN ed.is_estimated THEN ' (est.)' ELSE '' END AS \"Next earnings\" FROM w LEFT JOIN stats s ON s.instrument_id = w.id LEFT JOIN val pe ON pe.instrument_id = w.id AND pe.metric = 'pe' LEFT JOIN val mc ON mc.instrument_id = w.id AND mc.metric = 'mcap' LEFT JOIN fx ON fx.currency = mc.currency LEFT JOIN earnings_dates ed ON ed.instrument_id = w.id AND ed.earnings_date >= CURRENT_DATE ORDER BY 8 DESC NULLS LAST, w.symbol"
        }
      ]
    },
