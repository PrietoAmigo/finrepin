          "rawQuery": true,
          "rawSql": "SELECT i.symbol || ' · ' || to_char(ed.earnings_date, 'DD Mon') AS \"Next earnings\" FROM earnings_dates ed JOIN instruments i ON i.id = ed.instrument_id WHERE i.in_watchlist AND ed.earnings_date >= CURRENT_DATE ORDER BY ed.earnings_date, i.symbol LIMIT 1"
